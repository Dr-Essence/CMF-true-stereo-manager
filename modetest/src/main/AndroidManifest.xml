<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- AudioManager.setParameters: turns the audio HAL's own PCM recording on. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- DRIVER STUDY: the microphones hear what the earpiece and speaker play. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:label="CMF L/R Test"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="fullSensor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- One process per tuning. The names are only process names inside this
             app: com.nothing.audioeffect matches them with String.contains()
             against its lists (checked in the order music, video, navigation,
             game), so each lands in exactly one tuning. -->

        <!-- On no list: MUSIC, Nothing's default. -->
        <activity android:name=".MusicTest" android:exported="false"
            android:process=":music" android:screenOrientation="sensorLandscape" />

        <!-- Contains "org.videolan.vlc" (video list): MOVIE. -->
        <activity android:name=".MovieTest" android:exported="false"
            android:process="org.videolan.vlc.cmftest" android:screenOrientation="sensorLandscape" />

        <!-- MOVIE again, with a DynamicsProcessing effect on its own session, as VLC
             has: does Android's rotation swap skip a stream with its own effects? -->
        <activity android:name=".MovieEffectTest" android:exported="false"
            android:process="org.videolan.vlc.cmftest2" android:screenOrientation="sensorLandscape" />

        <!-- Contains "com.google.android.apps.maps" (navigation list): SPEECH. -->
        <activity android:name=".SpeechTest" android:exported="false"
            android:process="com.google.android.apps.maps.cmftest" android:screenOrientation="sensorLandscape" />

        <!-- Contains "com.ludo.king" (game list): GAME. -->
        <activity android:name=".GameTest" android:exported="false"
            android:process="com.ludo.king.cmftest" android:screenOrientation="sensorLandscape" />

        <!-- The ways apps hand sound to Android, each on no Dirac list (MUSIC). -->
        <!-- AAudio low latency + exclusive, as a game asks: Android's direct (MMAP)
             path if it grants one, its fast mixer otherwise. -->
        <activity android:name=".AAudioTest" android:exported="false"
            android:process=":aaudio" android:screenOrientation="sensorLandscape" />
        <activity android:name=".AAudioSharedTest" android:exported="false"
            android:process=":aaudioshared" android:screenOrientation="sensorLandscape" />
        <activity android:name=".FloatTest" android:exported="false"
            android:process=":float" android:screenOrientation="sensorLandscape" />
        <!-- DRIVER STUDY: upright, so neither Android nor the module swaps. -->
        <activity android:name=".StudyActivity" android:exported="false"
            android:process=":study" android:screenOrientation="portrait" />
        <!-- SYNC TEST: upright, as the driver study, so left is the earpiece throughout. -->
        <activity android:name=".SyncActivity" android:exported="false"
            android:process=":sync" android:screenOrientation="portrait" />
        <!-- MP3 decoded by the audio DSP (compressed offload), as music players do. -->
        <activity android:name=".OffloadTest" android:exported="false"
            android:process=":offload" android:screenOrientation="sensorLandscape" />
    </application>
</manifest>
